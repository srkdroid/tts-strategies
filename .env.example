# =================================================================
# TTS Strategies - Environment Variables Configuration
# =================================================================

# Serverless Session & Authentication Secrets (Required)
JWT_SECRET=your_jwt_secret_min_32_characters_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_characters_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Telegram Authentication & Bot Integration (Optional / Production)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Upstash Redis / Vercel KV Database (Required for persistent storage)
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_rest_api_token
